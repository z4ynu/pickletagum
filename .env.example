# Used by the Vercel GitHub OAuth functions. Never commit the real values.
CMS_GITHUB_CLIENT_ID=
CMS_GITHUB_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CMS_OAUTH_SECRET=
# Exact public Vercel/custom domain, no trailing slash (example: https://pickletagum.vercel.app)
CMS_SITE_URL=
