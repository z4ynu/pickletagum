# Public values, safe to use in browser code. Set these in Vercel too.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Server-only value. Add this in Vercel; never expose it with a PUBLIC_ prefix.
OPENAI_API_KEY=sk_replace_with_your_key
# Optional. Defaults to gpt-5.6-luna.
OPENAI_AVAILABILITY_MODEL=gpt-5.6-luna
