---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="PickleTagum editor">
  <main class="admin shell">
    <div class="admin__heading"><div><p class="eyebrow eyebrow--dark"><span></span>Private editor</p><h1>Manage courts</h1><p>Update the directory without touching code.</p></div></div>
    <section id="login-panel" class="admin-login"><p>Sign in with your approved email address.</p><form id="login-form"><input id="email" type="email" required placeholder="you@example.com" /><button>Send sign-in link</button></form><p id="login-message"></p></section>
    <section id="editor" hidden><div class="admin__bar"><p id="admin-email"></p><button id="new-court">+ Add court</button><button id="sign-out" class="secondary">Sign out</button></div><p id="editor-message" aria-live="polite"></p><div id="court-list" class="court-grid"></div></section>
  </main>
  <dialog id="court-dialog"><form id="court-form" method="dialog"><div class="dialog__header"><h2 id="dialog-title">Add court</h2><button type="button" id="close-dialog" class="icon-button">×</button></div><div class="form-grid"><input name="id" required placeholder="ID (example: the-lob)" /><input name="name" required placeholder="Venue name" /><input name="area" required placeholder="Area / barangay" /><fieldset><legend>Court environment</legend><label><input name="types" type="checkbox" value="indoor" /> Indoor</label><label><input name="types" type="checkbox" value="outdoor" /> Outdoor</label></fieldset><input name="court_count" type="number" min="0" value="0" placeholder="Court count" /><input name="price_range" placeholder="Price range (optional)" /><label class="upload"><span>Upload court photo</span><input name="image_file" type="file" accept="image/png,image/jpeg,image/webp" /></label><input name="image_alt" placeholder="What is shown in the photo?" /><select name="booking_method"><option value="custom_site">Booking site</option><option value="pickle_hub">PickleHub</option><option value="facebook">Facebook</option><option value="phone">Phone</option></select><input name="link" required placeholder="Booking/contact link" /><input name="facebook_link" placeholder="Facebook page (optional)" /><textarea name="note" required placeholder="Short note"></textarea><input name="last_verified" type="date" required /></div><div class="dialog__actions"><button id="delete-court" type="button" class="danger" hidden>Delete court</button><button type="submit">Save changes</button></div></form></dialog>
  <script is:inline>
    const config=window.PICKLETAGUM_SUPABASE, message=document.querySelector('#login-message');
    if(!config.url||!config.key) message.textContent='Add the two PUBLIC_SUPABASE variables, then redeploy.';
    else { const client=window.supabase.createClient(config.url,config.key), login=document.querySelector('#login-panel'), editor=document.querySelector('#editor'), list=document.querySelector('#court-list'), dialog=document.querySelector('#court-dialog'), form=document.querySelector('#court-form'), status=document.querySelector('#editor-message'), del=document.querySelector('#delete-court'); let current=null;
      const esc=v=>String(v||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const render=rows=>{ list.innerHTML=rows.map(c=>`<article class="court-card admin-card" data-id="${esc(c.id)}"><div class="court-preview">${c.image_src?`<img src="${esc(c.image_src)}" alt="${esc(c.image_alt||c.name)}">`:`<div class="court-preview__fallback"><span>Venue photo</span><strong>Coming soon</strong></div>`}<span class="court-preview__badge">${esc(c.types.join(' + '))}</span></div><div class="court-card__body"><div class="court-card__topline"><span>${esc(c.area)}</span></div><h2>${esc(c.name)}</h2><p>${esc(c.note)}</p><button class="edit-court">Edit court</button></div></article>`).join(''); };
      const load=async()=>{const {data,error}=await client.from('courts').select('*').order('name'); if(error) status.textContent=error.message; else render(data||[]);};
      const open=c=>{current=c||null; form.reset(); document.querySelector('#dialog-title').textContent=c?'Edit court':'Add court'; del.hidden=!c; if(c){for(const [k,v] of Object.entries(c)){const field=form.elements[k];if(field&&v!=null)field.value=v;} [...form.querySelectorAll('[name=types]')].forEach(x=>x.checked=c.types.includes(x.value));} form.elements.last_verified.value=c?.last_verified||new Date().toISOString().slice(0,10); dialog.showModal();};
      const show=async()=>{const {data:{user}}=await client.auth.getUser();if(!user)return;const {data:admin}=await client.from('admin_users').select('user_id').eq('user_id',user.id).maybeSingle();if(!admin){message.textContent='This email is not approved as an editor.';return;}login.hidden=true;editor.hidden=false;document.querySelector('#admin-email').textContent=user.email;load();};
      document.querySelector('#login-form').addEventListener('submit',async e=>{e.preventDefault();message.textContent='Sending…';const {error}=await client.auth.signInWithOtp({email:document.querySelector('#email').value,options:{emailRedirectTo:location.href}});message.textContent=error?error.message:'Check your email for the sign-in link.';});
      document.querySelector('#new-court').onclick=()=>open();document.querySelector('#close-dialog').onclick=()=>dialog.close();list.onclick=async e=>{const card=e.target.closest('.admin-card');if(!card)return;const {data}=await client.from('courts').select('*').eq('id',card.dataset.id).single();if(data)open(data);};
      form.addEventListener('submit',async e=>{e.preventDefault();status.textContent='Saving…';const f=new FormData(form),row=Object.fromEntries(f);row.types=[...form.querySelectorAll('[name=types]:checked')].map(x=>x.value);row.court_count=Number(row.court_count||0);for(const k of['price_range','image_alt','facebook_link'])if(!row[k])row[k]=null;const file=f.get('image_file');delete row.image_file;if(file&&file.size){const path=`${Date.now()}-${file.name.replace(/[^a-z0-9._-]/gi,'-')}`;const {error}=await client.storage.from('court-images').upload(path,file,{upsert:true});if(error){status.textContent=error.message;return;}row.image_src=client.storage.from('court-images').getPublicUrl(path).data.publicUrl;}else if(current)row.image_src=current.image_src;const {error}=await client.from('courts').upsert(row);status.textContent=error?error.message:'Saved.';if(!error){dialog.close();load();}});
      del.onclick=async()=>{if(!current||!confirm(`Delete ${current.name}?`))return;const {error}=await client.from('courts').delete().eq('id',current.id);status.textContent=error?error.message:'Deleted.';if(!error){dialog.close();load();}};document.querySelector('#sign-out').onclick=async()=>{await client.auth.signOut();location.reload();};show(); }
  </script>
</BaseLayout>
