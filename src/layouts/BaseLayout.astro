---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

const { title = 'PickleTagum — Pickleball courts in Tagum City' } = Astro.props;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="An independent directory of pickleball courts in Tagum City and their booking routes." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <script define:vars={{ supabaseUrl, supabaseKey }}>window.PICKLETAGUM_SUPABASE = { url: supabaseUrl, key: supabaseKey };</script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>
