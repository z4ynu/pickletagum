---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

const {
  title = 'PickleTagum — Pickleball courts in Tagum City',
  description = 'Find pickleball courts in Tagum City, compare basic venue details, and book directly with each venue.',
  robots = 'index, follow',
} = Astro.props;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || '';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PickleTagum" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <script define:vars={{ supabaseUrl, supabaseKey }}>window.PICKLETAGUM_SUPABASE = { url: supabaseUrl, key: supabaseKey };</script>
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>
