<section class="court-section shell" aria-labelledby="court-list-heading">
  <div class="section-heading">
    <div><p class="eyebrow eyebrow--dark"><span></span>Directory</p><h2 id="court-list-heading">Courts to check out</h2></div>
    <div class="directory-tools">
      <div class="view-toggle" role="group" aria-label="Directory layout">
        <button type="button" class="is-active" data-view="grid" aria-pressed="true">Grid</button>
        <button type="button" data-view="list" aria-pressed="false">List</button>
      </div>
    </div>
  </div>
  <div class="court-grid court-grid--grid" id="court-grid" aria-live="polite">
    <div class="court-loading" id="court-loading" aria-label="Loading courts"><span></span><span></span><span></span></div>
  </div>
  <p id="empty-state" class="empty-state" hidden></p>
</section>

<dialog class="court-details-dialog" id="court-details-dialog" aria-labelledby="court-details-title">
  <button type="button" class="court-details-dialog__close" aria-label="Close court details">&times;</button>
  <img id="court-details-image" alt="" hidden />
  <div class="court-details-dialog__content"><p class="eyebrow eyebrow--dark" id="court-details-area"></p><h2 id="court-details-title"></h2><p id="court-details-note"></p></div>
</dialog>

<section class="court-section court-section--coming shell" id="coming-soon-section" aria-labelledby="coming-soon-heading" hidden>
  <div class="section-heading">
    <div><p class="eyebrow eyebrow--dark"><span></span>On the way</p><h2 id="coming-soon-heading">Coming soon</h2></div>
    <p id="coming-soon-count" aria-live="polite"></p>
  </div>
  <div class="court-grid court-grid--grid" id="coming-soon-grid"></div>
</section>
