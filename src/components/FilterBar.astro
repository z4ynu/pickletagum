<section class="filter-wrap shell" aria-label="Court filters">
  <div class="filter-bar">
    <details class="mobile-area-filter" open>
      <summary id="mobile-area-summary">Area: Everywhere</summary>
      <div class="filter-group filter-group--area" id="area-filter" role="group" aria-label="Filter by area">
        <span class="filter-label">Location</span>
        <button class="filter-chip is-active" data-area="all" type="button" aria-pressed="true">Everywhere</button>
        <details class="more-areas-filter">
          <summary>More areas</summary>
          <div class="more-areas-filter__list"></div>
        </details>
      </div>
    </details>
    <div class="filter-group filter-group--type" role="group" aria-label="Filter by court type">
      <span class="filter-label">Venue type</span>
      <button class="filter-chip" data-type="indoor" type="button" aria-pressed="false">Indoor</button>
      <button class="filter-chip" data-type="outdoor" type="button" aria-pressed="false">Outdoor</button>
    </div>
    <div class="filter-group filter-group--count" role="group" aria-label="Filter by number of courts">
      <span class="filter-label">Court capacity</span>
      <button class="filter-chip" data-count="1" type="button" aria-label="1 court" aria-pressed="false">1</button>
      <button class="filter-chip" data-count="2" type="button" aria-label="2 courts" aria-pressed="false">2</button>
      <button class="filter-chip" data-count="3" type="button" aria-label="3 courts" aria-pressed="false">3</button>
      <button class="filter-chip" data-count="4+" type="button" aria-label="4 or more courts" aria-pressed="false">4+</button>
    </div>
  </div>
</section>
