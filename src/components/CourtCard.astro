---
const { court } = Astro.props;
const labels = { pickle_hub: 'Book on PickleHub', custom_site: 'Visit booking site', facebook: 'Open Facebook', phone: 'Call venue' };
const relativeDate = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(`${court.last_verified}T12:00:00`));
---
<article class={`court-card booking--${court.booking_method}`} data-court data-area={court.area} data-type={court.type} data-search={`${court.name} ${court.area}`.toLowerCase()}>
  <div class="rally-strip" aria-hidden="true"><span></span><i></i><b></b></div>
  <div class="court-card__body">
    <div class="court-card__topline"><span>{court.area}</span><span class="venue-type">{court.type}</span></div>
    <h2>{court.name}</h2>
    <div class="court-meta">
      <span>{court.type === 'indoor' ? 'Covered / indoor' : 'Open-air court'}</span>
      {court.court_count > 0 && <span>{court.court_count} {court.court_count === 1 ? 'court' : 'courts'}</span>}
      {court.price_range && <span>{court.price_range}</span>}
    </div>
    <p>{court.note}</p>
    <div class="court-card__bottom">
      <time datetime={court.last_verified}>Checked {relativeDate}</time>
      <a href={court.link} target={court.link.startsWith('http') ? '_blank' : undefined} rel={court.link.startsWith('http') ? 'noreferrer' : undefined}>{labels[court.booking_method]} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</article>
